# Secrets de las Edge Functions cuando corren en local (supabase start las lee automáticamente).
# En la nube se cargan con: supabase secrets set GEMINI_API_KEY=... FAL_AI_KEY=...
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY las inyecta la CLI sola, no van acá.
GEMINI_API_KEY=
FAL_AI_KEY=
# Orígenes permitidos para CORS (separados por coma). Sin definir => "*" (solo aceptable en local).
# En la nube: supabase secrets set ALLOWED_ORIGIN=https://tu-dominio.com
ALLOWED_ORIGIN=
