# Frontend (Vite). Estas dos variables van al bundle del browser: son públicas por diseño.
# Para el stack local, los valores salen de `supabase status` (API URL y anon key).
# Vite carga .env y después .env.local (que pisa a .env). Convención del proyecto:
#   .env        -> Supabase en la nube
#   .env.local  -> Supabase local (supabase start)
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=
